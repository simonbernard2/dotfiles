#!/bin/sh
set -eu

ROOT_DIR="$(cd -- "$(dirname -- "$0")/.." && pwd)"
SUDO_READY=0

load_brew() {
  if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv)"
  elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
}

ensure_sudo() {
  if [ "$SUDO_READY" -eq 0 ]; then
    echo "Some cask installs may require administrator privileges."
    sudo -v
    SUDO_READY=1
  fi
}

app_exists() {
  app="$1"
  [ -e "/Applications/$app" ] ||
    [ -e "$HOME/Applications/$app" ] ||
    [ -e "/System/Applications/$app" ]
}

font_exists() {
  font="$1"
  [ -e "$HOME/Library/Fonts/$font" ] ||
    [ -e "/Library/Fonts/$font" ]
}

cask_exists_outside_brew() {
  case "$1" in
    docker)
      app_exists "Docker.app"
      ;;
    font-meslo-lg-nerd-font)
      font_exists "MesloLGS NF Regular.ttf"
      ;;
    google-chrome)
      app_exists "Google Chrome.app"
      ;;
    iterm2)
      app_exists "iTerm.app"
      ;;
    logseq)
      app_exists "Logseq.app"
      ;;
    raycast)
      app_exists "Raycast.app"
      ;;
    slack)
      app_exists "Slack.app"
      ;;
    spotify)
      app_exists "Spotify.app"
      ;;
    visual-studio-code)
      app_exists "Visual Studio Code.app"
      ;;
    vlc)
      app_exists "VLC.app"
      ;;
    *)
      return 1
      ;;
  esac
}

install_casks() {
  sed -n 's/^cask "\([^"]*\)".*/\1/p' "$ROOT_DIR/install/Caskfile" |
  while IFS= read -r cask; do
    if brew list --cask "$cask" >/dev/null 2>&1; then
      echo "Cask already installed by Homebrew: $cask"
      continue
    fi

    if cask_exists_outside_brew "$cask"; then
      echo "Cask app already exists outside Homebrew, skipping: $cask"
      continue
    fi

    ensure_sudo
    brew install --cask "$cask"
  done
}

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed. Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

load_brew

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew install finished, but brew is still not available on PATH." >&2
  exit 1
fi

brew bundle --file "$ROOT_DIR/install/Brewfile"
install_casks
